<?xml version="1.0" encoding="UTF-8"?>
<!--
  The motor. Everything else in the capture pipeline is a thing that runs when
  called; this is what calls it. Without a unit like this the store still only
  fills when a person types a command, which is the regression the pipeline
  exists to close.

  Two jobs in one: sweep picks up transcripts no session-end hook claimed, then
  work takes what the queue holds. Both are safe to run at any time — the
  ledger's unique key makes a repeat a no-op, and a claim already held by
  another worker is skipped rather than duplicated.

  Copy to ~/Library/LaunchAgents/, edit the three paths, then load it. See the
  README section on capture for what to change and how to check it is running.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mashu.capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <!-- EDIT: the path to the mashu executable in this project's venv. -->
        <string>MASHU=REPLACE_WITH_PROJECT/.venv/bin/mashu; "$MASHU" sweep --days 2 &amp;&amp; "$MASHU" work --limit 6</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <!-- Do not run at load: the first run should be one you watched. -->
    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <!-- api, cli:claude, cli:codex, or auto. auto takes the API when a key
             is present and falls back to whichever CLI is on PATH. -->
        <key>MASHU_EXTRACTOR</key>
        <string>auto</string>
    </dict>

    <!-- EDIT: somewhere you will actually look when something goes wrong. -->
    <key>StandardOutPath</key>
    <string>REPLACE_WITH_PROJECT/.capture.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_PROJECT/.capture.log</string>
</dict>
</plist>
