#!/bin/sh
# Reject commit messages matching the local banned-pattern list.
set -eu

hook_dir=$(dirname "$0")
. "$hook_dir/_banned.sh"
. "$hook_dir/_budget.sh"

banned_load || exit 1
trap 'rm -f "$BANNED_PATTERNS_FILE"' EXIT

hits=$(grep -n -E -f "$BANNED_PATTERNS_FILE" "$1" || true)
if [ -n "$hits" ]; then
    printf '%s\n' "commit-msg: banned pattern in the commit message:" >&2
    printf '%s\n' "$hits" | sed 's/^/    /' >&2
    printf '%s\n' "commit-msg: commit aborted. Rewrite the message; do not use --no-verify." >&2
    exit 1
fi

if budget_raised && ! grep -q -E '^Test-Budget-Instruction: .+' "$1"; then
    cat >&2 <<MSG
commit-msg: this commit raises $BUDGET_FILE from $(budget_head) to $(budget_staged).
    A raise needs the user's instruction, quoted in a trailer line:
    Test-Budget-Instruction: "<the user's words>"
MSG
    exit 1
fi

exit 0
