#!/usr/bin/env bash
# Reject staged paths or staged content matching the local banned-pattern list.
set -eu

hook_dir=$(dirname "$0")
. "$hook_dir/_banned.sh"

banned_load || exit 1
scratch=$(mktemp -d) || exit 1
trap 'rm -f "$BANNED_PATTERNS_FILE"; rm -rf "$scratch"' EXIT

if ! git diff --cached --name-only -z --diff-filter=ACMR > "$scratch/paths"; then
    printf '%s\n' "pre-commit: cannot list staged paths." >&2
    exit 1
fi

failed=0
while IFS= read -r -d '' f; do
    if hits=$(banned_scan <<< "$f"); then
        printf '%s\n' "pre-commit: banned pattern in staged path:" >&2
        printf '    %s\n' "$f" >&2
        failed=1
    else
        status=$?
        if [ "$status" -ne 1 ]; then
            printf '%s\n' "pre-commit: cannot check banned patterns in staged path $f." >&2
            failed=1
        fi
    fi

    if ! git cat-file blob ":$f" > "$scratch/blob" 2> "$scratch/git-error"; then
        printf '%s\n' "pre-commit: cannot read staged blob $f:" >&2
        cat "$scratch/git-error" >&2
        failed=1
        continue
    fi
    if hits=$(banned_scan -n -- "$scratch/blob"); then
        printf '%s\n' "pre-commit: banned pattern in $f:" >&2
        printf '%s\n' "$hits" | sed 's/^/    /' >&2
        failed=1
    else
        status=$?
        if [ "$status" -ne 1 ]; then
            printf '%s\n' "pre-commit: cannot check banned patterns in staged blob $f." >&2
            failed=1
        fi
    fi
done < "$scratch/paths"

if [ "$failed" -ne 0 ]; then
    printf '%s\n' "pre-commit: commit aborted. Remove the flagged text; do not use --no-verify." >&2
    exit 1
fi

exit 0
