{
  "productName": "Mashu",
  "version": "4.0.0",
  "identifier": "dev.mashu.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mashu",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRjE4OTc2Q0FCOTFGOTQKUldTVUg3bktkb254VEFJN3F5N3ZBdEFJV1pWMm9rWTF4MVFVQTFmZDdFdzZmdjVCa05GVkZ6MzQK",
      "endpoints": [
        "https://github.com/unknowns53/mashu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
